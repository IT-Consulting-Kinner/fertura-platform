# Kopiere diese Datei nach .env und passe die Werte an.
# .env wird NICHT eingecheckt (siehe .gitignore).

POSTGRES_DB=fertura
POSTGRES_USER=fertura
POSTGRES_PASSWORD=change-me

# Sicherheit (PRODUKTION: zwingend eigene, zufällige Werte setzen!)
# SECURITY_SALT: allgemeiner App-Schlüssel (CSRF etc.)
# APP_ENCRYPTION_KEY: Schlüssel für verschlüsselte Settings (AES-256-GCM).
SECURITY_SALT=dev-salt-change-me-0123456789abcdef0123456789abcdef
APP_ENCRYPTION_KEY=dev-encryption-key-change-me-fedcba9876543210
