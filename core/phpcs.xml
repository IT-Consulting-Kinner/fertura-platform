<?xml version="1.0"?>
<ruleset name="App">
    <rule ref="CakePHP"/>
    <rule ref="SlevomatCodingStandard.TypeHints.ReturnTypeHint.MissingNativeTypeHint">
        <exclude-pattern>*/src/Controller/*</exclude-pattern>
    </rule>

    <!--
        Modernised ruleset (E147): with PHP 8.3 native type declarations and a
        PHPStan level-8 gate, several stock sniffs fight this codebase's
        deliberate, type-safe idioms rather than catching real problems. They are
        relaxed below; genuine gaps (missing return types, tabs, etc.) are fixed
        in the code instead.
    -->

    <!-- Per-method docblocks are optional: native param/return types plus the
         existing class-level docblocks document the API; PHPStan enforces types.
         A docblock that IS present is still fully validated. -->
    <rule ref="CakePHP.Commenting.FunctionComment.Missing">
        <severity>0</severity>
    </rule>

    <!-- Intentional assign-and-check idiom, used throughout the API controllers:
         `if ($denied = $this->requireScope('...')) { return $denied; }`. -->
    <rule ref="SlevomatCodingStandard.ControlStructures.AssignmentInCondition">
        <severity>0</severity>
    </rule>

    <!-- Test doubles are deliberately co-located with the test that uses them
         (one *Test.php file may declare a small Fake/Stub class). -->
    <rule ref="PSR1.Classes.ClassDeclaration.MultipleClasses">
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>
    <rule ref="Squiz.Classes.ClassFileName.NoMatch">
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>

    <!-- Allow a fully-qualified name when the short name collides with another
         import (e.g. App\Infrastructure\Uuid next to Symfony\Component\Uid\Uuid):
         the FQN is the correct disambiguation there, not a style slip. -->
    <rule ref="SlevomatCodingStandard.Namespaces.ReferenceUsedNamesOnly">
        <properties>
            <property name="allowFullyQualifiedNameForCollidingClasses" value="true"/>
        </properties>
    </rule>

    <!-- count() in a loop condition is flagged generically, but the few uses here
         are necessary (the collection grows inside the loop, so the size must be
         re-evaluated) — not a hoistable constant. -->
    <rule ref="Squiz.PHP.DisallowSizeFunctionsInLoops">
        <severity>0</severity>
    </rule>

    <file>src/</file>
    <file>tests/</file>
</ruleset>
