{
    "id": "isolated_anon_module",
    "name": "Isolated Anon Module",
    "version": "1.0.0",
    "type": "main",
    "edition": "free",
    "description": "Out-of-Process-Modul mit Anonymize-Collector, Scheduled-Task und Daten-Resolver (Phase-3-E2E).",
    "publisher": "Fertura",
    "php_namespace": "IsolatedAnon",
    "core_compatibility": ">=1.0.0 <2.0.0",
    "requires_license": false,
    "dependencies": [],
    "contracts_used": [],
    "contracts_provided": [
        {
            "name": "isolated_anon_module.resolver.echo",
            "type": "resolver",
            "version": "1.0.0",
            "description": "Daten-Resolver: gibt die Eingabe zurück.",
            "error_behavior": "Ohne registrierten Anbieter greift der Resolver-Default (Eingabe unverändert)."
        }
    ],
    "collectors_registered": [
        {
            "contract": "core.collector.anonymize",
            "version": ">=1.0.0 <2.0.0",
            "class": "IsolatedAnon\\AnonContributor"
        },
        {
            "contract": "core.collector.scheduled",
            "version": ">=1.0.0 <2.0.0",
            "class": "IsolatedAnon\\PingTask"
        }
    ],
    "resolvers_registered": [
        {
            "contract": "isolated_anon_module.resolver.echo",
            "version": ">=1.0.0 <2.0.0",
            "class": "IsolatedAnon\\EchoResolver"
        }
    ],
    "permissions": [
        {
            "resource_type": "data",
            "name": "isolated_anon_module.data",
            "is_scoped": true
        }
    ],
    "tables": [
        {
            "table": "user_data",
            "scope": "global",
            "reason": "Isolations-/Anonymisierungs-Test-Fixture; Tenancy hier nicht im Fokus (out_of_process-RPC propagiert keinen Tenant-Kontext, eigener Belang)."
        }
    ]
}
