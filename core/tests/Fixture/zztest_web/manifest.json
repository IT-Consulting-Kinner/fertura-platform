{
    "id": "zztest_web",
    "name": "Web Test Module",
    "version": "1.0.0",
    "type": "main",
    "edition": "free",
    "description": "Fixture fuer den Core-Web-Mount-Dispatcher-Test (Kap. 23.16.3).",
    "publisher": "Fertura",
    "php_namespace": "ZztestWeb",
    "core_compatibility": ">=1.0.0 <2.0.0",
    "requires_license": false,
    "dependencies": [],
    "config_schema": [
        {
            "key": "greeting_suffix",
            "label": "zztest.config.greeting_suffix",
            "type": "string",
            "default": "",
            "help": "zztest.config.greeting_suffix_help"
        }
    ],
    "web_routes": [
        {
            "path": "/dashboard",
            "class": "ZztestWeb\\Web\\DashboardPage",
            "template": "dashboard",
            "auth": "user",
            "title": "Web Test"
        },
        {
            "path": "/public",
            "class": "ZztestWeb\\Web\\PublicPage",
            "template": "public_page",
            "auth": "guest",
            "title": "Web Test"
        },
        {
            "path": "/admin",
            "class": "ZztestWeb\\Web\\AdminPage",
            "template": "admin_index",
            "auth": "user",
            "area": "zztest_web_admin",
            "nav_group": "zztest.nav.group",
            "nav": "zztest.nav.config",
            "title": "Web Test Admin"
        },
        {
            "path": "/download",
            "class": "ZztestWeb\\Web\\DownloadPage",
            "template": "dashboard",
            "auth": "guest",
            "title": "Web Test Download"
        }
    ],
    "api_routes": [
        {
            "method": "GET",
            "path": "/status",
            "class": "ZztestWeb\\Api\\StatusEndpoint",
            "auth": "public"
        },
        {
            "method": "GET",
            "path": "/secure",
            "class": "ZztestWeb\\Api\\SecureEndpoint"
        }
    ]
}
