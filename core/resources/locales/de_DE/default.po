msgstr "Sperrt die Plattform für alle ausser dem aktivierenden Operator und fährt die Hintergrundverarbeitung kontrolliert herunter."

msgid "admin.maintenance.engage_heading"
msgstr "Wartung aktivieren"

msgid "admin.maintenance.engage_hint"
msgstr "Alle anderen Benutzer werden mit 503 abgewiesen; laufende Jobs werden abgewartet (Drain)."

msgid "admin.maintenance.reason_label"
msgstr "Grund (optional)"

msgid "admin.maintenance.engage"
msgstr "Wartung aktivieren"

msgid "admin.maintenance.engage_confirm"
msgstr "Wartungsmodus jetzt aktivieren? Alle anderen Benutzer werden ausgesperrt."

msgid "admin.maintenance.active"
msgstr "Wartungsmodus aktiv"

msgid "admin.maintenance.draining"
msgstr "Drainage läuft … %s offene Vorgänge"

msgid "admin.maintenance.drained"
msgstr "System ist leergelaufen (drained)."

msgid "admin.maintenance.timed_out"
msgstr "Drain-Frist abgelaufen — es laufen noch Vorgänge."

msgid "admin.maintenance.opened_at"
msgstr "Aktiviert am"

msgid "admin.maintenance.release"
msgstr "Wartung beenden"

msgid "admin.maintenance.release_confirm"
msgstr "Wartungsmodus beenden und Worker fortsetzen?"

msgid "flash.maintenance.engaged"
msgstr "Wartungsmodus aktiviert."

msgid "flash.maintenance.already_active"
msgstr "Es ist bereits ein Wartungsmodus aktiv."

msgid "flash.maintenance.released"
msgstr "Wartungsmodus beendet."

msgid "flash.maintenance.not_active"
msgstr "Es ist kein Wartungsmodus aktiv."

msgid "flash.maintenance.action_in_progress"
msgstr "Wartung kann nicht beendet werden: es laufen noch kritische Aktionen."

msgid "admin.maintenance.blocking_actions"
msgstr "%s kritische Aktion(en) laufen — Beenden gesperrt."

msgid "flash.maintenance.action_queued"
msgstr "Geschützte Aktion eingereiht — der Worker führt sie nach dem Drain aus."

msgid "flash.module.use_protected_install"
msgstr "Wartungsmodus aktiv: bitte die geschützte Installation unter Wartung nutzen."

msgid "flash.maintenance.tenant_params"
msgstr "Mandanten-Schlüssel und -Name sind erforderlich."

msgid "admin.maintenance.action_tenant_heading"
msgstr "Geschützte Mandanten-Provisionierung"

msgid "admin.maintenance.action_tenant_hint"
msgstr "Läuft als kritische Aktion: Pflicht-Backup → Mandant anlegen → Verifikation, mit aktionseigenem Rollback (Löschen des frischen Mandanten)."

msgid "admin.maintenance.action_tenant_key"
msgstr "Mandanten-Schlüssel (a-z, 0-9, _-)"

msgid "admin.maintenance.action_tenant_name"
msgstr "Mandantenname"

msgid "admin.maintenance.action_tenant_submit"
msgstr "Geschützt provisionieren"

msgid "admin.maintenance.action_secret_heading"
msgstr "Geschützte Schlüsselrotation"

msgid "admin.maintenance.action_secret_hint"
msgstr "Re-verschlüsselt alle Geheimnisse mit dem aktiven Schlüssel. Voraussetzung: der ALTE Schlüssel ist als SECURITY_ENCRYPTION_KEY_OLD bereitgestellt. Kein aktionseigener Undo → bei Fehler Pre-Action-Backup wiederherstellen."

msgid "admin.maintenance.action_secret_submit"
msgstr "Schlüssel rotieren"

msgid "admin.maintenance.action_secret_confirm"
msgstr "Schlüsselrotation jetzt einreihen? Ist der alte Schlüssel als SECURITY_ENCRYPTION_KEY_OLD bereitgestellt?"

msgid "flash.maintenance.trust_params"
msgstr "Alte und neue Anker-Schlüssel-ID sind erforderlich."

msgid "admin.maintenance.action_trust_heading"
msgstr "Geschützte Trust-Anker-Rotation"

msgid "admin.maintenance.action_trust_hint"
msgstr "Der neue Anker gilt ab sofort unbegrenzt, der alte läuft nach dem Überlappungsfenster aus. Voraussetzung: der neue Anker ist bereits installiert. Aktionseigener Rollback (Wiederherstellen der Gültigkeitsfenster)."

msgid "admin.maintenance.action_trust_old"
msgstr "Alte Schlüssel-ID"

msgid "admin.maintenance.action_trust_new"
msgstr "Neue Schlüssel-ID"

msgid "admin.maintenance.action_trust_overlap"
msgstr "Überlappung (Tage)"

msgid "admin.maintenance.action_trust_submit"
msgstr "Geschützt rotieren"

msgid "admin.maintenance.action_install_heading"
msgstr "Geschützte Modul-Installation"

msgid "admin.maintenance.action_install_hint"
msgstr "Läuft als kritische Aktion: Pflicht-Backup → Installation → Verifikation, mit aktionseigenem Rollback. Beenden ist gesperrt, bis die Aktion terminal ist."

msgid "admin.maintenance.action_install_submit"
msgstr "Geschützt installieren"

msgid "admin.maintenance.action_type"
msgstr "Typ"

msgid "admin.maintenance.action_status"
msgstr "Status"

msgid "admin.maintenance.action_message"
msgstr "Meldung"

msgid "admin.maintenance.restore_heading"
msgstr "Manueller Restore erforderlich"

msgid "admin.maintenance.restore_intro"
msgstr "Eine kritische Aktion konnte ihren Rollback nicht abschließen — der Datenstand ist ungewiss. Stelle das Pre-Action-Backup per CLI wieder her und quittiere es anschließend hier. Bis dahin bleibt die Freigabe gesperrt."

msgid "admin.maintenance.restore_warning"
msgstr "Achtung: Der Restore ist tenant-übergreifend und destruktiv — er setzt ALLE Mandanten auf den Backup-Stand zurück (Datenverlust seit dem Backup für alle)."

msgid "admin.maintenance.restore_backup_label"
msgstr "Pre-Action-Backup"

msgid "admin.maintenance.restore_verify_label"
msgstr "Vorher prüfen (nicht-destruktiv)"

msgid "admin.maintenance.restore_cmd_label"
msgstr "Wiederherstellen (destruktiv)"

msgid "admin.maintenance.restore_no_backup"
msgstr "Kein Pre-Action-Backup verknüpft — Backups per „bin/cake backup list“ prüfen."

msgid "admin.maintenance.restore_ack_note_label"
msgstr "Notiz (optional, nur im Audit-Log)"

msgid "admin.maintenance.restore_ack_submit"
msgstr "Als manuell wiederhergestellt quittieren"

msgid "admin.maintenance.restore_ack_confirm"
msgstr "Bestätigen, dass der Restore durchgeführt bzw. der Zustand bereinigt ist? Das hebt die Sperre auf und erlaubt die Freigabe."

msgid "admin.maintenance.restore_acknowledged_badge"
msgstr "quittiert"

msgid "admin.maintenance.needs_ack"
msgstr "%s manueller Restore offen — erst quittieren, dann ist das Beenden möglich."

msgid "flash.maintenance.restore_acknowledged"
msgstr "Manueller Restore quittiert — die Freigabe ist jetzt möglich."

msgid "flash.maintenance.restore_ack_failed"
msgstr "Quittung nicht möglich: Aktion nicht im Zustand needs_manual_restore oder bereits quittiert."
